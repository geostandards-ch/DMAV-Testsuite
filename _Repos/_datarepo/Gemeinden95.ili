TRANSFER INTERLIS1;

MODEL Gemeinden95

  DOMAIN

    LKoord = COORD2 2480000.000 1070000.000 2850000.000 1310000.000;


   TOPIC Gemeinden =

     TABLE Gemeinde =
       Name: TEXT*50;
       BFSNr: [1 .. 9999];
       Kanton: TEXT*2; !! Kantonskürzel, z.B. ZH
     IDENT BFSNr;
     END Gemeinde;

     TABLE Gemeindegrenze =
       Gemeinde_von: -> Gemeinde;  !! Beziehung 1-m
       Geometrie: SURFACE WITH (STRAIGHTS, ARCS) VERTEX LKoord 
         WITHOUT OVERLAPS > 0.050;
         !! Die Flächen aller Gemeinden bilden ein Flächennetz (AREA)
     NO IDENT
     END Gemeindegrenze;

   END Gemeinden.

END Gemeinden95.

FORMAT FREE;

CODE
  BLANK = DEFAULT, UNDEFINED = DEFAULT, CONTINUE = DEFAULT;
  TID = ANY;
END.
